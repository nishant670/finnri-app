<?xml version="1.0" encoding="utf-8"?>
<!-- The 2 × 1 widget (board R14-Widget): Type and the mic, on the pill. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <RelativeLayout
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
      android:id="@+id/widget_type"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:background="@drawable/widget_circle_neutral"
      android:contentDescription="@string/widget_type_label"
      android:padding="13dp"
      android:src="@drawable/ic_keyboard_ink"/>

    <ImageView
      android:id="@+id/widget_capture"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:background="@drawable/capture_circle"
      android:contentDescription="@string/widget_speak_label"
      android:padding="13dp"
      android:src="@drawable/ic_mic_ink"/>
  </RelativeLayout>
</FrameLayout>
