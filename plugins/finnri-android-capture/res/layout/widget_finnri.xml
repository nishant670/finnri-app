<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4 × 1 widget (board R14-Widget): the f mark, "Log an expense", Type and
  the orange mic, on a 64dp pill. Capture only: it shows no figure, because a
  home screen is visible to anyone holding the phone.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <LinearLayout
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <TextView
      android:id="@+id/widget_logo"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="@drawable/widget_logo"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:text="f"
      android:textColor="@color/finnri_logo_ink"
      android:textSize="19sp"
      android:textStyle="bold"/>

    <TextView
      android:id="@+id/widget_prompt"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_prompt"
      android:textColor="@color/finnri_widget_hint"
      android:textSize="15sp"/>

    <ImageView
      android:id="@+id/widget_type"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:contentDescription="@string/widget_type_label"
      android:padding="10dp"
      android:src="@drawable/ic_keyboard_ink"/>

    <ImageView
      android:id="@+id/widget_capture"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="4dp"
      android:background="@drawable/capture_circle"
      android:contentDescription="@string/widget_speak_label"
      android:padding="12dp"
      android:src="@drawable/ic_mic_ink"/>
  </LinearLayout>
</FrameLayout>
